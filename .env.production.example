# PispIAr — Plantilla de Variables de Entorno para Producción (AWS EC2 + Docker Compose)
# Copiar este archivo a .env en el servidor EC2 y completar los valores reales.
# IMPORTANTE: Nunca commitear el archivo .env real con credenciales ni secretos.

# ==============================================================================
# 1. DOMINIO PÚBLICO Y ACCESO WEB (nip.io + HTTPS)
# ==============================================================================
# Hostname público asociado a la Elastic IP de la instancia EC2 (ej. 54.123.45.67.nip.io).
# Caddy obtendrá y renovará automáticamente el certificado TLS con Let's Encrypt para este host.
PUBLIC_DOMAIN=54.123.45.67.nip.io

# URL HTTPS definitiva de la API (debe coincidir con https://${PUBLIC_DOMAIN}).
# Requerida durante el build de Next.js (apps/web/Dockerfile). Sin /api ni barra final.
API_URL=https://54.123.45.67.nip.io

# URL base del frontend para componer enlaces de invitación (https://${PUBLIC_DOMAIN}).
FRONTEND_URL=https://54.123.45.67.nip.io

# ==============================================================================
# 2. SEGURIDAD Y REVERSE PROXY
# ==============================================================================
# IP fija asignada a Caddy en la red interna de Docker Compose (docker-compose.prod.yml).
# Permite a NestJS confiar en X-Forwarded-For para rate limiting sin spoofing.
HTTP_TRUSTED_PROXIES=172.28.0.10

# Secreto de firma JWT de la API (mínimo 32 caracteres aleatorios de alta entropía).
# Generar por ejemplo con: openssl rand -base64 36
JWT_SECRET=reemplazar-con-secreto-aleatorio-seguro-minimo-32-caracteres

# Entorno y zona horaria
NODE_ENV=production
PORT=3000
APP_TIMEZONE=America/Argentina/Buenos_Aires
SWAGGER_ENABLED=false

# ==============================================================================
# 3. BASE DE DATOS (AWS RDS PostgreSQL + pgvector)
# ==============================================================================
# Cadena de conexión hacia la instancia RDS en la subred privada de la VPC.
# En producción exige TLS estricto (verify-full + sslaccept=strict para Prisma 7 y pg).
# No agregar sslrootcert ni sslcert en la URL compartida; la CA se carga por runtime.
# Formato: postgresql://<USUARIO>:<PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?sslmode=verify-full&sslaccept=strict
DATABASE_URL=postgresql://app_user:secreto_db@pispiar-db.c123456789.us-east-1.rds.amazonaws.com:5432/manual_prod?sslmode=verify-full&sslaccept=strict

# Rutas al certificado CA oficial de Amazon RDS montado en solo lectura dentro de api y migrator.
NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-global-bundle.pem
SSL_CERT_FILE=/etc/ssl/certs/rds-global-bundle.pem

# ==============================================================================
# 4. CACHÉ, SESIONES Y COLAS (AWS ElastiCache Redis)
# ==============================================================================
# Endpoint de ElastiCache Redis (nodo único o replication group sin cluster mode).
# Formato sin TLS: redis://pispiar-cache.c123456789.0001.use1.cache.amazonaws.com:6379
# Formato con In-Transit Encryption (TLS): rediss://pispiar-cache...:6379
REDIS_URL=redis://pispiar-cache.c123456789.0001.use1.cache.amazonaws.com:6379
REDIS_KEY_PREFIX=pispiar_prod:

# Habilita el worker BullMQ en el proceso de la API para procesar documentos en segundo plano
PROCESSING_WORKER_ENABLED=true

# ==============================================================================
# 5. ALMACENAMIENTO DE DOCUMENTOS (AWS S3)
# ==============================================================================
# Nombre del bucket S3 privado y región de AWS.
S3_BUCKET=pispiar-documentos-prod
AWS_REGION=us-east-1

# Cuando la EC2 tiene asociado un IAM Instance Profile, NO completar Access Keys.
# El SDK de AWS tomará credenciales temporales automáticamente mediante IMDSv2.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Opciones de compatibilidad S3 (dejar por defecto para AWS S3 estándar)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ==============================================================================
# 6. ASISTENTE DE IA (Google Gemini)
# ==============================================================================
# Clave de API de Google Gemini para embeddings de búsqueda y respuestas del asistente.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# ==============================================================================
# 7. INVITACIONES POR CORREO (Resend)
# ==============================================================================
# Proveedor de correo: 'resend' para envío productivo real, o 'local' para modo demo sin envíos.
INVITATION_EMAIL_PROVIDER=local
RESEND_API_KEY=
INVITATION_EMAIL_FROM=onboarding@resend.dev
