   generator client {
     provider     = "prisma-client"
     output       = "../src/generated/prisma"
     moduleFormat = "cjs"
   }

   datasource db {
     provider = "postgresql"
   }

// ─────────────────────────────────────────────────────────────
// Pareja C · Documentos (Matías) — spec 001, plan 2.1
// Con tablas de otras parejas (users, areas) nos relacionamos
// solo por ID, sin relaciones de Prisma ni claves foráneas.
// Pendiente: Chunk lo agrega Guille en su migración (A2) y el
// índice de una sola versión CURRENT por documento va con HU16.
// ─────────────────────────────────────────────────────────────

enum DocumentStatus {
  ACTIVE // vigente
  ARCHIVED // archivado: no se busca ni se muestra a quien no es ADMIN
}

enum DocumentVersionStatus {
  CURRENT // la versión vigente del documento
  REPLACED // reemplazada por una versión más nueva
}

enum ProcessingStatus {
  PENDING // guardada, esperando en la cola
  PROCESSING // el worker la está procesando
  READY // fragmentos y embeddings listos
  FAILED // error; se ve en processingError
}

// HU13 · HU16 · HU37 — dueño: Matías
model Document {
  id          String         @id @default(uuid()) @db.Uuid
  title       String         @db.VarChar(200)
  description String?        @db.VarChar(1000)
  status      DocumentStatus @default(ACTIVE)
  ownerId     String         @map("owner_id") @db.Uuid // responsable (users de A)
  reviewDate  DateTime       @map("review_date") @db.Date // obligatoria (R4, spec P3)
  createdById String         @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime?      @map("archived_at") @db.Timestamptz(3)

  areas    DocumentArea[]
  versions DocumentVersion[]

  @@index([status])
  @@index([reviewDate])
  @@index([createdAt]) // orden del listado (R13)
  @@map("documents")
}

// HU15 — dueño: Matías
model DocumentArea {
  documentId String   @map("document_id") @db.Uuid
  areaId     String   @map("area_id") @db.Uuid // areas de A
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, areaId])
  @@index([areaId])
  @@map("document_areas")
}

// HU13 · HU16 — dueño: Matías (el worker de Guille actualiza el procesamiento)
model DocumentVersion {
  id               String                @id @default(uuid()) @db.Uuid
  documentId       String                @map("document_id") @db.Uuid
  versionNumber    Int                   @map("version_number")
  status           DocumentVersionStatus @default(CURRENT)
  storageKey       String                @unique @map("storage_key") // documents/{documentId}/{versionId}.{pdf|txt|md}
  originalFileName String                @map("original_file_name") @db.VarChar(255)
  mimeType         String                @map("mime_type") @db.VarChar(100) // tipo detectado, no el del navegador
  sizeBytes        Int                   @map("size_bytes")
  checksum         String                @db.Char(64) // SHA-256 en hexadecimal, minúsculas
  processingStatus ProcessingStatus      @default(PENDING) @map("processing_status")
  processingError  String?               @map("processing_error")
  processedAt      DateTime?             @map("processed_at") @db.Timestamptz(3)
  uploadedById     String                @map("uploaded_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // chunks Chunk[] → se agrega junto con Chunk (A2)

  @@unique([documentId, versionNumber])
  @@index([processingStatus])
  @@index([checksum]) // duplicados (R8b)
  @@map("document_versions")
}
