# Dirección del backend al que Next reenvía /api (sin /api al final).
# En desarrollo, si queda vacía, se usa http://localhost:3000. En producción es obligatoria.
# No lleva el prefijo NEXT_PUBLIC_: se usa solo en el servidor de Next.
API_URL=

# A-09: activar pantalla y sesión real localmente. Por defecto conserva
# la sesión simulada para no romper el flujo de pruebas E2E preexistente.
# Es una bandera pública de UI, NO debe usarse para secretos ni autorización.
NEXT_PUBLIC_REAL_AUTH=false
