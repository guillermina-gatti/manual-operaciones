DATABASE_URL=postgresql://app:app@localhost:5432/manual
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/manual_test
JWT_SECRET=
PORT=3000
APP_TIMEZONE=America/Argentina/Buenos_Aires
PROCESSING_WORKER_ENABLED=true
# Swagger queda habilitado por defecto fuera de producción. En producción sólo
# se publica con el opt-in explícito SWAGGER_ENABLED=true.
SWAGGER_ENABLED=

# Lista separada por comas de IP/CIDR de proxies efectivamente controlados.
# Vacía = no confiar en X-Forwarded-For. No usar hasta confirmar la topología.
HTTP_TRUSTED_PROXIES=
# URL base del frontend para componer enlaces de invitación (/registro#token=...).
# En development/test admite http: o https: con fallback a http://localhost:3001.
# En producción/staging es obligatoria y exige protocolo https: sin credenciales, query ni fragmento.
FRONTEND_URL=http://localhost:3001

# A-INV-EMAIL / HU30 - Canal de entrega de invitaciones
# local: solo desarrollo y test; no envia correos.
# ses: AWS SES (proveedor objetivo de produccion; usa IAM Role de EC2).
# resend: proveedor alternativo de correo transaccional.
INVITATION_EMAIL_PROVIDER=local

# Region opcional para AWS SES (si se omite, hace fallback a AWS_REGION).
AWS_SES_REGION=

# Credenciales del proveedor alternativo Resend (solo si INVITATION_EMAIL_PROVIDER=resend).
# Nunca incluir claves reales en este archivo.
RESEND_API_KEY=

# Remitente autorizado y verificado en el proveedor elegido (obligatorio para ses/resend).
# En AWS SES la identidad debe estar verificada en la region efectiva (AWS_SES_REGION si esta definida; si no, AWS_REGION).
INVITATION_EMAIL_FROM=

AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_CHAT_MODEL=
REDIS_URL=redis://localhost:6379
# Prefijo opcional para aislar claves cuando Redis sea compartido.
REDIS_KEY_PREFIX=
TEST_REDIS_URL=redis://localhost:6379/1
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
