DATABASE_URL=postgresql://app:app@localhost:5432/manual
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/manual_test
JWT_SECRET=
PORT=3000
APP_TIMEZONE=America/Argentina/Buenos_Aires
PROCESSING_WORKER_ENABLED=true
# Swagger queda habilitado por defecto fuera de producción. En producción sólo
# se publica con el opt-in explícito SWAGGER_ENABLED=true.
SWAGGER_ENABLED=

# Lista separada por comas de IP/CIDR de proxies efectivamente controlados.
# Vacía = no confiar en X-Forwarded-For. No usar hasta confirmar la topología.
HTTP_TRUSTED_PROXIES=
# URL base del frontend para componer enlaces de invitación (/registro#token=...).
# En development/test admite http: o https: con fallback a http://localhost:3001.
# En producción/staging es obligatoria y exige protocolo https: sin credenciales, query ni fragmento.
FRONTEND_URL=http://localhost:3001

# A-INV-EMAIL - Canal de entrega de invitaciones
# local: solo desarrollo y test; no envia correos.
# resend: proveedor de correo transaccional.
# Produccion requiere resend con configuracion valida.
INVITATION_EMAIL_PROVIDER=local

# Credenciales del proveedor Resend.
# Nunca incluir claves reales en este archivo.
RESEND_API_KEY=

# Remitente autorizado en un dominio verificado.
# Ejemplo futuro: PispIAr <invitaciones@tu-dominio.com>
INVITATION_EMAIL_FROM=

AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_CHAT_MODEL=
REDIS_URL=redis://localhost:6379
# Prefijo opcional para aislar claves cuando Redis sea compartido.
REDIS_KEY_PREFIX=
TEST_REDIS_URL=redis://localhost:6379/1
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
