DATABASE_URL=postgresql://app:app@localhost:5432/manual
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/manual_test
JWT_SECRET=
# URL base del frontend para componer enlaces de invitación (/registro#token=...).
# En development/test admite http: o https: con fallback a http://localhost:3001.
# En producción/staging es obligatoria y exige protocolo https: sin credenciales, query ni fragmento.
FRONTEND_URL=http://localhost:3001
AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=
REDIS_URL=redis://localhost:6379
TEST_REDIS_URL=redis://localhost:6379/1
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=